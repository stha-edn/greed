# This file contains config that is not checked into git. See resources/config.edn for more config
# options.

# Where will your app be deployed?
DOMAIN=example.com

# Email is sent via Google Workspace SMTP as admin@mygreed.co.za. Generate an app password at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification on the account) and paste it
# into SMTP_PASSWORD below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=admin@mygreed.co.za
SMTP_PASSWORD=
# Where emails appear to come from and where replies go.
SMTP_FROM=admin@mygreed.co.za
SMTP_REPLY_TO=support@mygreed.co.za

# Recaptcha is used to protect your sign-in page from bots. Go to
# https://www.google.com/recaptcha/about/ and add a site. Select v2 invisible. Add localhost and the
# value of DOMAIN above to your list of allowed domains.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Google Analytics 4 (optional). Create a GA4 property at https://analytics.google.com/ and paste
# its Measurement ID (starts with "G-").
GOOGLE_ANALYTICS_ID=

XTDB_TOPOLOGY=standalone
# Production uses Postgres for XTDB storage (self-hosted on the DigitalOcean droplet).
# Create the DB/user on the droplet first, then set the real password here:
PROD_XTDB_TOPOLOGY=jdbc
XTDB_JDBC_URL=jdbc:postgresql://localhost:5432/greed?user=greed&password=CHANGE_ME&sslmode=disable

# What port should the nrepl server be started on (in dev and prod)?
NREPL_PORT=7888


## Autogenerated. Create new secrets with `clj -M:dev generate-secrets`

# Used to encrypt session cookies.
COOKIE_SECRET={{ new-secret 16 }}
# Used to encrypt email sign-in links.
JWT_SECRET={{ new-secret 32 }}

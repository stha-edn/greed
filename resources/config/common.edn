{;; Bump this to re-show the "app has been updated" dashboard banner to
 ;; every user (see dashboard/app-update-banner-due?). Not tied to any
 ;; build/deploy tooling — just an explicit marker you change by hand
 ;; whenever there's something worth announcing.
 :app/version "4"

 :error/recaptcha "You failed the recaptcha test. Try again, and make sure you aren't blocking scripts from Google."
 :error/invalid-email "Invalid email. Try again with a different address."
 :error/invalid-credentials "Invalid credentials. Try again."
 :error/account-deactivated "This account has been deactivated. Please contact support to get reactivated."
 :error/send-failed "We weren't able to send an email to that address. If the problem persists, try another address."
 :error/email-taken "That email is already in use by another account."
 :error/invalid-link "This password reset link is invalid or has expired. Request a new one."
 :error/password-blank "Your password can't be empty."
 :error/password-mismatch "The passwords don't match. Try again."
 :error/default "There was an error."

 :alert/user-saved "Your user has been successfully saved or updated."
 :alert/finances-saved "Your finances have been successfully saved or updated."
 :alert/tax-profile-saved "Your tax assessment profile has been saved."
 :alert/budget-item-saved "Your budget item has been successfully saved or updated."
 :alert/budget-item-deleted "Your budget item has been successfully deleted."
 :alert/goal-saved "Your goal has been successfully saved or updated."
 :alert/goal-deleted "Your goal has been successfully deleted."
 :alert/user-deleted "The user and all of their data has been deleted."
 :alert/user-not-found "That user could not be found."
 :alert/email-taken "That email is already in use by another account."
 :alert/cannot-delete-self "You can't delete your own account from here."
 :alert/cannot-remove-own-admin-role "You can't remove your own admin role from here."
 :alert/password-hashed "That user's plaintext password has been securely hashed."
 :alert/password-already-hashed "That user's password was already securely hashed."
 :alert/app-updated "The app has been updated."

 :alert/errors #{:alert/email-taken
                 :alert/user-not-found
                 :alert/cannot-delete-self
                 :alert/cannot-remove-own-admin-role}

 :user/fields #{"firstname" "lastname" "age" "email" "password"}

 :finances/fields #{"bank" "account-type" "salary" "payday"}

 :banking/banks #{:absa :capitec :discovery-bank :fnb :nedbank :standard-bank}
 :banking/card-colours {:absa "from-red-500 to-red-800"
                        :capitec "from-gray-600 to-black"
                        :discovery-bank "from-yellow-500 to-amber-800"
                        :fnb "from-teal-500 to-teal-800"
                        :nedbank "from-emerald-500 to-green-800"
                        :standard-bank "from-blue-500 to-blue-800"
                        :default "from-gray-600 to-black"}

 :banking/account-types {:absa #{"Cheque account" "Transact" "Gold Cheque" "Platinum Cheque"
                                 "Private Banking" "Wealth" "Student" "Savings account"
                                 "Fixed deposit" "Tax-free savings" "Credit card"}
                         :capitec #{"Global One" "Global One Savings Plan" "Global One Credit Card"
                                    "Fixed deposit"}
                         :discovery-bank #{"Gold credit account" "Platinum credit account"
                                           "Black credit account" "Purple credit account"
                                           "Transaction account" "Full banking suite"
                                           "Savings account" "Tax-free savings account"
                                           "Real-time forex account" "Fixed deposit account"}
                         :fnb #{"Easy" "Easy Zero" "Aspire" "Premier" "Private Client"
                                "Private Wealth" "Student" "Savings account" "Money Maximiser"
                                "Tax-free savings account" "Credit card"}
                         :nedbank #{"Pay-as-you-use" "Transactor" "Gold" "Platinum"
                                    "Private Client" "Private Wealth" "Student" "JustSave"
                                    "Fixed deposit" "Credit card"}
                         :standard-bank #{"MyMo" "Current account" "Blue" "Platinum"

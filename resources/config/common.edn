 ;; Plans (com.greed.data.plans). Prices in cents (R49.00 = 4900).
 ;; Yearly is ten months' price: two months free.
 :plans {:trial-days 14
         :free-statement-months 1
         :tiers {:premium  {:name "Premium"  :monthly 4900  :yearly 49000}
                 :business {:name "Business" :monthly 14900 :yearly 149000}}}


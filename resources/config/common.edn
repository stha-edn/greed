 ;; VAT (SARS). Check each February's Budget; thresholds apply from April 2026.
 :vat/rate 15
 :vat/compulsory-threshold 2300000
 :vat/voluntary-threshold 120000

 ;; Company income tax (SARS). Add next year's SBC table after each February Budget.
 :company-tax/rate 27
 :company-tax/sbc-tables
 [{:from "2025-04-01" :to "2026-03-31"
   :brackets [{:above 0 :base 0 :rate 0}
              {:above 95750 :base 0 :rate 7}
              {:above 365000 :base 18848 :rate 21}
              {:above 550000 :base 57698 :rate 27}]}
  {:from "2026-04-01" :to "2027-03-31"
   :brackets [{:above 0 :base 0 :rate 0}
              {:above 99000 :base 0 :rate 7}
              {:above 365000 :base 18620 :rate 21}
              {:above 550000 :base 57470 :rate 27}]}]

 ;; Dividends tax withheld by a company paying its shareholders (SARS, Budget 2026: no change).
 :dividends-tax/rate 20

